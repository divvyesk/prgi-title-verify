# ==============================================================================
# PRGI TitleGuard — Environment Variables Template
# Copy this file to infra/.env before running docker compose
# ==============================================================================

# Database Configuration (pgvector PostgreSQL 17)
POSTGRES_DB=prgi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/prgi

# Backend FastAPI Configuration
PORT=8000
# STUB_MODE=1 serves fixtures and needs no database. Set 0 for the real
# pipeline — but note the compose stack only creates the SCHEMA, so run
# scripts/load_titles.py against the db first or every query hits an empty
# table. See the header comment in docker-compose.yml.
STUB_MODE=1
LOG_LEVEL=info

# Groq API key for the RAG explainer and the Agentic Title Studio.
# agents/.env is gitignored and never reaches the image, so without this the
# container logs "LLM call failed entirely" and falls back to verbatim
# guideline text for every explanation.
GROQ_API_KEY=

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE=http://localhost:8000
